{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"isolatedModules": true,
		"lib": ["DOM", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noImplicitAny": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"target": "ES2020"
	},
	"include": ["src/**/*.ts", "../chrome-extension/lib/*.js"]
}
