{
	"name": "read-deeper-obsidian",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc --noEmit -p . && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test --out-extension:.js=.mjs --external:jsdom --external:esbuild --log-level=warning && node --test .test/*.test.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"jsdom": "^24.1.3",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3"
	}
}
